# ========== C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua ==========
#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Offer Assistance"
msgstr "Hilfe anbieten"

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Thank the stars you stopped! We barely escaped the last sector and our engines are damaged. We are critically low on supplies. Do you have any Food or Medical Supplies to spare?"
msgstr "Dank den Sternen, dass Sie angehalten haben! Wir sind dem letzten Sektor kaum entkommen und unsere Antriebe sind beschädigt. Unsere Vorräte sind kritisch niedrig. Haben Sie Nahrung oder medizinische Güter übrig?"

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Here is 50 Food."
msgstr "Hier sind 50 Nahrung."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Here is 50 Medical Supplies."
msgstr "Hier sind 50 medizinische Güter."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "I'm sorry, I don't have anything to spare right now."
msgstr "Es tut mir leid, ich habe im Moment nichts übrig."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "I can't help you right now."
msgstr "Ich kann Ihnen jetzt gerade nicht helfen."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "The enemy is ruthless... stay safe out there."
msgstr "Der Feind ist rücksichtslos... bleiben Sie da draußen in Sicherheit."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Thank you so much! You saved our lives. By the way, be careful... ${rumor}"
msgstr "Vielen Dank! Sie haben unsere Leben gerettet. Übrigens, seien Sie vorsichtig... ${rumor}"

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Safe travels."
msgstr "Sichere Reise."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Hazard Pay"
msgstr "Gefahrenzulage"

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Your Merchant captain negotiated a 75,000 credit hazard pay fee for the supplies."
msgstr "Ihr Kaufmann-Kapitän hat eine Gefahrenzulage von 75.000 Credits für die Vorräte ausgehandelt."

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Smuggled Goods"
msgstr "Schmuggelware"

#: C:/Users/erikf/AppData/Roaming/Avorion/mods/Cosmic Chronicles/data/scripts/entity/cc_refugeedialogue.lua:
msgid "Your Smuggler captain quietly skimmed 100,000 credits worth of valuables from the refugee convoy during the transfer."
msgstr "Ihr Schmuggler-Kapitän hat während des Transfers klammheimlich Wertsachen im Wert von 100.000 Credits aus dem Flüchtlingskonvoi abgezweigt."


